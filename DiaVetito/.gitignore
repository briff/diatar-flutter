.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated code — do not commit; `flutter pub get` regenerates all of it.
# lib/l10n/generated/ comes from `flutter gen-l10n` (driven by l10n.yaml);
# edit the ARB sources in lib/l10n/ instead. The plugin registrants come from
# the plugin list resolved out of pubspec.yaml.
# tvos/ is deliberately left tracked: its registrant is written by the
# flutter-tvos fork, which is only available on the CI macOS runner.
/lib/l10n/generated/
/linux/flutter/generated_plugin_registrant.cc
/linux/flutter/generated_plugin_registrant.h
/linux/flutter/generated_plugins.cmake
/macos/Flutter/GeneratedPluginRegistrant.swift
/windows/flutter/generated_plugin_registrant.cc
/windows/flutter/generated_plugin_registrant.h
/windows/flutter/generated_plugins.cmake
